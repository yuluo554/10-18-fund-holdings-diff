      "role": "holdings_fallback",
      "encoding": "gbk"
    },
    "eastmoney_scale": {
      "kind": "commercial",
      "label": "来源：基金定期报告公开披露",
      "endpoint": "https://fundf10.eastmoney.com/FundArchivesDatas.aspx",
      "role": "scale"
    },
    "eastmoney_managers": {
      "kind": "commercial",
      "label": "来源：基金定期报告公开披露",
      "endpoint": "https://fundf10.eastmoney.com/jjjl_{code}.html",
      "role": "managers",
      "encoding": "utf-8"
